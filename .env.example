# Shared portfolio contract. Deployment values are coordinator-owned.
PROJECT_SLUG=lineage-fuzzer
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8104
APP_PUBLIC_URL=http://localhost:8104
APP_STATE_DIR=.lineage-fuzzer
DATAHUB_GMS_URL=http://127.0.0.1:8080
DATAHUB_MCP_URL=http://127.0.0.1:8000/mcp
DATAHUB_TOKEN=
DATAHUB_DOMAIN=Demo / Lineage Fuzzer
DATAHUB_PROJECT_TAG=project-lineage-fuzzer
DATAHUB_URN_PREFIX=fuzzer.
DEMO_FIXTURE_ROOT=demo/fixtures/lineage-fuzzer
LINEAGE_FUZZER_READINESS_DATASET_URN=urn:li:dataset:(urn:li:dataPlatform:duckdb,fuzzer.raw.orders,DEV)

# Required in APP_ENV=hackathon. Set to the exact promoted 40-character Git commit.
LINEAGE_FUZZER_CANDIDATE_SHA=
# Set only after complete live capture succeeds. The adjacent receipt is also required.
# Seed/reset invalidates both files, so recapture before restarting the public campaign.
# LINEAGE_FUZZER_CONTEXT_FILE=.lineage-fuzzer/campaign-context.json

LINEAGE_FUZZER_ENVIRONMENT=development
LINEAGE_FUZZER_STATE_DIR=.lineage-fuzzer

# Safety gate: fault injection remains disabled until explicitly approved.
LINEAGE_FUZZER_INJECTION_ENABLED=false
LINEAGE_FUZZER_ALLOWED_DATABASE_PATHS=demo/fixtures/lineage-fuzzer/lineage_fuzzer.duckdb
LINEAGE_FUZZER_ALLOWED_ENVIRONMENTS=DEV
LINEAGE_FUZZER_ALLOWED_PLATFORMS=duckdb
LINEAGE_FUZZER_REQUIRED_SANDBOX_TAG=lineage-fuzzer-sandbox
LINEAGE_FUZZER_REQUIRED_MARKER_KEY=sandbox
LINEAGE_FUZZER_REQUIRED_MARKER_VALUE=true
DATAHUB_MCP_TIMEOUT_SECONDS=15
